{
  "name": "bohselecta",
  "version": "0.3.0-alpha.7",
  "private": true,
  "description": "A cost-conscious terminal model router for Codex and Claude",
  "type": "module",
  "bin": {
    "bohselecta": "bin/bohselecta"
  },
  "engines": {
